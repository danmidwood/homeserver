# Managed by Ansible. Do not edit on the host.
[global]
   workgroup = WORKGROUP
   server string = {{ ansible_hostname }}
   security = user
   passdb backend = tdbsam

   # SMB1 is off. macOS has not needed it for years and it is the protocol
   # every worm in the family targets.
   server min protocol = SMB2
   client min protocol = SMB2

   # The LAN and loopback only. Time Machine over a wide-area link is not
   # practical and this share must never be reachable from the internet; the
   # router forwards nothing to 445, and binding narrowly means a future
   # forward would still not expose it.
   interfaces = lo 192.168.178.0/24
   bind interfaces only = yes
   hosts allow = 127.0.0.1 192.168.178.0/24
   hosts deny = 0.0.0.0/0

   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes

   # The Apple extensions. catia and streams_xattr give the resource forks and
   # illegal-character mapping macOS expects; fruit is what makes Time Machine
   # recognise the share at all.
   vfs objects = catia fruit streams_xattr
   fruit:metadata = stream
   fruit:model = TimeCapsule8,119
   fruit:posix_rename = yes
   fruit:veto_appledouble = no
   fruit:wipe_intentionally_left_blank_rfork = yes
   fruit:delete_empty_adfiles = yes

   log file = /var/log/samba/%m.log
   max log size = 1000
   logging = file

{% for share in timemachine_shares %}
[{{ share.name }}]
   comment = {{ share.comment }}
   path = {{ timemachine_subvolume }}/{{ share.name }}
   valid users = {{ timemachine_user }}
   writable = yes
   browseable = yes
   fruit:time machine = yes
   # What Time Machine is told it may consume. It backs up until it reaches
   # this and then prunes its own oldest, so this is the eventual size.
   fruit:time machine max size = {{ share.size }}

{% endfor %}

# Managed by Ansible. Do not edit on the host.
theme: dark

server:
  address: 'tcp://0.0.0.0:9091'

log:
  level: info
  format: text

totp:
  # Hardware keys are the only second factor. If every key is lost, deleting
  # the rows from webauthn_credentials in the Authelia database returns the
  # account to a password and a fresh registration.
  disable: true

webauthn:
  disable: false
  display_name: {{ authelia_cookie_domain }}
  selection_criteria:
    # Asks the authenticator to verify the user with a biometric or PIN, so
    # the key alone proves both possession and knowledge.
    user_verification: preferred

authentication_backend:
  file:
    # A writable mount, because Authelia rewrites this file on a password
    # change.
    path: /users/users_database.yml
    password:
      # Matches the form produced by Ansible's password_hash('sha512', salt).
      algorithm: sha2crypt
      sha2crypt:
        variant: sha512

access_control:
  # Nothing reaches an application without a second factor.
  default_policy: two_factor
  rules:
    # The login page itself must be reachable unauthenticated.
    - domain: 'auth.{{ authelia_cookie_domain }}'
      policy: bypass

session:
  name: authelia_session
  same_site: lax
  cookies:
    # Scoped to the parent domain, which is what makes one login work across
    # every application under it.
    - domain: {{ authelia_cookie_domain }}
      authelia_url: {{ authelia_url }}
      expiration: 1h
      inactivity: 15m
      remember_me: 30d

regulation:
  max_retries: 3
  find_time: 2m
  ban_time: 12h

storage:
  encryption_key: {{ authelia_secrets.storage_encryption_key }}
  local:
    path: /data/db.sqlite3

notifier:
  # Registration and reset links are written here, to be read over SSH.
  filesystem:
    filename: /data/notification.txt

identity_validation:
  reset_password:
    jwt_secret: {{ authelia_secrets.jwt_secret }}

identity_providers:
  oidc:
    hmac_secret: {{ authelia_secrets.oidc_hmac_secret }}
    jwks:
      - key_id: 'main'
        algorithm: 'RS256'
        use: 'sig'
        key: |
{{ authelia_secrets.oidc_key | indent(10, true) }}
    clients:
{% for client in authelia_clients %}
      - client_id: '{{ client.id }}'
        client_name: '{{ client.name }}'
        client_secret: '{{ authelia_client_hash[client.id] }}'
        public: false
        authorization_policy: 'two_factor'
        require_pkce: {{ client.require_pkce | default(false) | lower }}
{% if client.require_pkce | default(false) %}
        pkce_challenge_method: 'S256'
{% endif %}
        redirect_uris:
{% for uri in client.redirect_uris %}
          - '{{ uri }}'
{% endfor %}
        response_modes:
{% for mode in client.response_modes | default(['form_post', 'query']) %}
          - '{{ mode }}'
{% endfor %}
        scopes:
{% for scope in client.scopes | default(['openid', 'profile', 'email', 'groups']) %}
          - '{{ scope }}'
{% endfor %}
        userinfo_signed_response_alg: 'none'
        token_endpoint_auth_method: '{{ client.token_endpoint_auth_method | default("client_secret_basic") }}'
{% endfor %}

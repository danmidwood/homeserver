<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>home</title>
<style>
  :root {
    --bg: #f6f6f4;
    --card: #ffffff;
    --ink: #1a1a18;
    --muted: #6b6b66;
    --line: #e2e2dd;
    --accent: #3a6b4f;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #16171a;
      --card: #1e2024;
      --ink: #e8e8e5;
      --muted: #9a9a94;
      --line: #2c2f34;
      --accent: #7fb894;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    padding: 3rem 1.25rem 4rem;
    background: var(--bg);
    color: var(--ink);
    font: 16px/1.55 ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  main { max-width: 46rem; margin: 0 auto; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
  @media (min-width: 34rem) {
    ul { grid-template-columns: repeat(2, 1fr); }
  }
  a.tile {
    display: block;
    padding: 1.1rem 1.25rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: border-color .15s ease, transform .15s ease;
  }
  a.tile:hover, a.tile:focus-visible {
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  a.tile:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .name { font-weight: 600; margin-bottom: 0.15rem; }
  .desc { color: var(--muted); font-size: 0.875rem; }
</style>
</head>
<body>
<main>
  <ul>
{% for link in caddy_homepage_links %}
    <li>
      <a class="tile" href="{{ link.url }}">
        <div class="name">{{ link.name }}</div>
        <div class="desc">{{ link.description }}</div>
      </a>
    </li>
{% endfor %}
  </ul>
</main>
</body>
</html>

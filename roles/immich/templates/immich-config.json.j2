{
  "//": "Managed by Ansible. Do not edit on the host. Settings present in this",
  "//2": "file become read-only in Immich's admin interface, which is the point:",
  "//3": "the repository is the source of truth for them.",
  "oauth": {
    "enabled": true,
    "issuerUrl": "{{ authelia_url }}/.well-known/openid-configuration",
    "clientId": "immich",
    "clientSecret": "{{ authelia_client_secret.immich }}",
    "scope": "openid email profile",
    "signingAlgorithm": "RS256",
    "profileSigningAlgorithm": "none",
    "storageLabelClaim": "preferred_username",
    "buttonText": "Sign in with Authelia",
    "autoRegister": true,
    "autoLaunch": false,
    "mobileOverrideEnabled": false,
    "mobileRedirectUri": ""
  },
  "passwordLogin": {
    "//": "Deliberately left enabled. It is the way back in if the OIDC client",
    "//2": "is misconfigured, and this instance holds the only copy of photos",
    "//3": "that are not otherwise duplicated anywhere.",
    "enabled": true
  }
}

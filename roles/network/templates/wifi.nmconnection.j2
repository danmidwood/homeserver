# Managed by Ansible. Do not edit on the host.
#
# The profile binds to whatever wifi device is present, so it still connects
# when the interface enumerates under a different name after a rebuild.
[connection]
id={{ item.id }}
uuid={{ item.uuid }}
type=wifi
autoconnect=true
autoconnect-priority={{ item.priority }}

[wifi]
mode=infrastructure
ssid={{ item.ssid }}

[wifi-security]
auth-alg=open
key-mgmt=wpa-psk
psk={{ wifi_psk }}

[ipv4]
method=auto

[ipv6]
addr-gen-mode=default
method=auto

[proxy]

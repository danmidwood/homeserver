#!/usr/bin/env bash
# Browse and play Reolink doorbell clips held on the server.
#
# This runs on the laptop, not the server, and changes nothing on either. It
# lists over SSH and fetches clips with scp, so it uses your normal SSH key and
# agent.
#
# It deliberately does NOT hand sftp:// URLs to VLC. VLC 3.0.8 bundles a libssh2
# too old to authenticate with an ed25519 key, so it hangs on a prompt that
# never appears. Fetching first also makes clips seekable, and at ~3 MB each
# that costs nothing.
#
#   doorbell                      today's events
#   doorbell yesterday            yesterday's
#   doorbell 2026-08-22           a specific day
#   doorbell -3                   three days ago
#   doorbell 2026-08-22 15:30     play the clip nearest that time
#   doorbell yesterday --all      fetch and queue the whole day
#   doorbell yesterday --long     only clips likely to show something
#   doorbell yesterday --long --thumbs   a labelled grid, inline (iTerm2 only)
#
# Grid shape is adjustable:
#   DOORBELL_THUMB_COLS=6 doorbell yesterday --thumbs    wider, shorter
#   DOORBELL_THUMB_PX=180 doorbell yesterday --thumbs    smaller tiles
#   doorbell yesterday --long --all
#   doorbell yesterday --min 12   an explicit threshold in seconds
#   doorbell 2026-08-22 15:30 --dry-run   show the match without playing
#
# Clips are cached under ~/.cache/doorbell, so replaying one is instant.
#
# --long filters to clips of at least eight seconds. That threshold is not
# arbitrary: clip lengths are bimodal, with a large spike at two to four seconds
# and a second population from eight upwards, and the trough between them sits
# at six to eight. The short spike is motion crossing the frame; the longer
# clips are where something actually happened. Roughly a quarter of clips
# survive the filter.
#
# Listings show duration and size. Durations come from ffprobe on the server;
# a clip that will not probe is a failed upload -- either zero bytes, or
# truncated part-way. Around 6% of recent clips are one or the other. They are
# labelled in listings and never selected for playing.

# No `set -u`: macOS ships bash 3.2, where referencing an empty array under
# `set -u` is itself an error. Every variable below has an explicit default.
set -o pipefail

HOST="${DOORBELL_HOST:-daniel@xps.fritz.box}"
ROOT="${DOORBELL_ROOT:-/mnt/storage/ftp/data/ftpuser}"
CACHE="${DOORBELL_CACHE:-$HOME/.cache/doorbell}"
VLC_APP="${DOORBELL_VLC_APP:-/Applications/VLC.app}"
LONG_SECONDS="${DOORBELL_LONG_SECONDS:-8}"
THUMB_COLS="${DOORBELL_THUMB_COLS:-4}"
THUMB_PX="${DOORBELL_THUMB_PX:-260}"

die() { echo "doorbell: $*" >&2; exit 1; }

usage() {
  sed -n '3,20p' "$0" | sed 's/^# \{0,1\}//'
  exit 0
}

# Accepts YYYY-MM-DD, today, yesterday, or -N for N days ago.
resolve_date() {
  case "$1" in
    today|"")   date +%Y-%m-%d ;;
    yesterday)  date -v-1d +%Y-%m-%d 2>/dev/null || date -d yesterday +%Y-%m-%d ;;
    -[0-9]*)    local n=${1#-}
                date -v-"${n}"d +%Y-%m-%d 2>/dev/null || date -d "${n} days ago" +%Y-%m-%d ;;
    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) echo "$1" ;;
    *)          die "unrecognised date: $1 (use YYYY-MM-DD, today, yesterday, or -N)" ;;
  esac
}

# The archive changed layout partway through its life: older clips live in
# YYYY/MM/ and newer ones in YYYY/MM/DD/. Searching the month directory by
# filename covers both, because the timestamp is in the name either way.
#
# Emits one tab-separated record per clip: path, size in bytes, duration in
# seconds. Durations come from ffprobe on the server, run four at a time --
# serially a busy day takes six seconds, in parallel a little over two, which is
# the difference between a listing that feels instant and one that does not.
list_clips() {
  local y="${1:0:4}" m="${1:5:2}" compact="${1//-/}"
  ssh -o ConnectTimeout=30 "$HOST" bash -s <<REMOTE
dir='${ROOT}/${y}/${m}'
tmp=\$(mktemp -d)
trap 'rm -rf "\$tmp"' EXIT

# Stills. Matching uses the timestamp in the FILENAME, not the upload time:
# filenames record when the event happened, and the still is always five to
# seven seconds after the clip. Upload times drift apart by however long the
# video took to transfer, which varies with its size.
find "\$dir" -type f -iname '*${compact}*.jpg' 2>/dev/null | sort > "\$tmp/jpgs"

find "\$dir" -type f -iname '*${compact}*.mp4' -print0 2>/dev/null \
  | xargs -0 -P 4 -I{} sh -c '
      f="\$1"
      s=\$(stat -c %s "\$f" 2>/dev/null || echo 0)
      d=""
      if [ "\$s" -gt 0 ]; then
        d=\$(ffprobe -v error -show_entries format=duration -of csv=p=0 "\$f" 2>/dev/null)
        case "\$d" in ""|N/A) d="" ;; esac
      fi
      printf "%s\037%s\037%s\n" "\$f" "\$s" "\$d"
    ' _ {} \
  | sort > "\$tmp/mp4s"

awk -F'\037' -v jpgs="\$tmp/jpgs" '
  # Seconds since midnight, from the YYYYMMDDHHMMSS in the filename. Everything
  # here is one days worth, so the date part can be ignored.
  function secs(path,   n, parts, ts) {
    n = split(path, parts, "_"); ts = parts[n]; sub(/\..*\$/, "", ts)
    return substr(ts, 9, 2) * 3600 + substr(ts, 11, 2) * 60 + substr(ts, 13, 2)
  }
  BEGIN { n = 0; while ((getline line < jpgs) > 0) { jp[++n] = line; jt[n] = secs(line) } }
  {
    still = ""; best = 16; bi = 0
    for (i = 1; i <= n; i++) {
      if (used[i]) continue
      gap = jt[i] - secs(\$1)
      if (gap >= 0 && gap < best) { best = gap; still = jp[i]; bi = i }
    }
    # Claimed exclusively. Without this, a clip whose own still failed to
    # upload borrows the one belonging to a nearby clip, and the thumbnail then
    # shows a different event entirely, which is worse than showing none.
    if (bi) used[bi] = 1
    printf "%s\037%s\037%s\037%s\n", \$1, \$2, \$3, still
  }
' "\$tmp/mp4s"
REMOTE
}

# 20260822231237 -> 23:12:37
time_of() {
  local base ts
  base=$(basename "$1" .mp4)
  ts="${base##*_}"
  echo "${ts:8:2}:${ts:10:2}:${ts:12:2}"
}

seconds_of() {
  local base ts
  base=$(basename "$1" .mp4)
  ts="${base##*_}"
  echo $(( 10#${ts:8:2} * 3600 + 10#${ts:10:2} * 60 + 10#${ts:12:2} ))
}

fetch() {
  local remote="$1" ymd="$2" dest
  dest="${CACHE}/${ymd}/$(basename "$remote")"
  if [ ! -f "$dest" ]; then
    mkdir -p "$(dirname "$dest")"
    # printf %q quotes the remote path for the remote shell, which scp invokes.
    # Every one of these filenames contains spaces, so without it scp treats
    # "Reolink", "Video" and "Doorbell_00_....mp4" as three separate sources.
    scp -q -o ConnectTimeout=20 "${HOST}:$(printf '%q' "$remote")" "$dest" \
      || { rm -f "$dest"; die "could not fetch $(basename "$remote")"; }
  fi
  echo "$dest"
}

# ---------------------------------------------------------------------------

case "${1:-}" in -h|--help|help) usage ;; esac

DATE_ARG="${1:-today}"
shift || true

WANT_TIME=""
PLAY_ALL=0
DRY_RUN=0
MIN_DUR=0
THUMBS=0
expect_min=0
for arg in "$@"; do
  if [ "$expect_min" -eq 1 ]; then
    case "$arg" in
      ''|*[!0-9.]*) die "--min needs a number of seconds, got: $arg" ;;
      *) MIN_DUR="$arg"; expect_min=0; continue ;;
    esac
  fi
  case "$arg" in
    --all) PLAY_ALL=1 ;;
    --dry-run) DRY_RUN=1 ;;
    --long) MIN_DUR="$LONG_SECONDS" ;;
    --thumbs) THUMBS=1 ;;
    --min) expect_min=1 ;;
    [0-9][0-9]:[0-9][0-9]) WANT_TIME="$arg" ;;
    [0-9][0-9]:[0-9][0-9]:[0-9][0-9]) WANT_TIME="$arg" ;;
    *) die "unrecognised argument: $arg" ;;
  esac
done
[ "$expect_min" -eq 1 ] && die "--min needs a number of seconds"

YMD=$(resolve_date "$DATE_ARG") || exit 1

# Each record is path<TAB>size<TAB>duration. Read the long way: bash 3.2 has
# no mapfile.
CLIPS=(); SIZES=(); DURS=(); STILLS=()
# Unit Separator, not tab. Tab is an IFS whitespace character, so bash
# collapses runs of them and strips leading ones -- a record with an empty
# duration field would silently shift the still into the duration slot. This
# went unnoticed while duration was the last field, where the trailing
# delimiter is harmlessly dropped.
while IFS=$'\037' read -r rpath rsize rdur rstill; do
  [ -z "$rpath" ] && continue
  CLIPS[${#CLIPS[@]}]="$rpath"
  SIZES[${#SIZES[@]}]="$rsize"
  DURS[${#DURS[@]}]="$rdur"
  STILLS[${#STILLS[@]}]="$rstill"
done < <(list_clips "$YMD")
[ "${#CLIPS[@]}" -eq 0 ] && { echo "No clips for ${YMD}."; exit 0; }

# 2305462 -> "2.2 MB"
human_size() {
  awk -v b="$1" 'BEGIN { if (b < 1048576) printf "%d KB", b/1024; else printf "%.1f MB", b/1048576 }'
}

# 10.176000 -> "10s"; empty -> a marker, because a clip that will not probe is
# a failed upload rather than a short one, and that is worth seeing in a list.
human_dur() {
  [ -z "$1" ] && { printf '     —'; return; }
  awk -v d="$1" 'BEGIN { printf "%5.1fs", d }'
}

# Two distinct failure modes, worth telling apart: a file that never received
# any bytes, and one that received some and stopped. Both are unplayable, but
# they suggest different things about where the upload broke.
bad_label() {
  local size="$1" dur="$2"
  [ -n "$dur" ] && return 0
  if [ "$size" -eq 0 ] 2>/dev/null; then printf '   empty upload'
  else printf '   truncated'
  fi
}

# True when a clip meets the duration threshold. Empty and truncated uploads
# have no duration and so never qualify, which is what we want -- they are the
# least interesting thing in the archive.
meets_min() {
  local dur="$1"
  [ "$MIN_DUR" = "0" ] && return 0
  # Anything not strictly numeric fails, rather than being handed to awk, which
  # would compare it as a string against the threshold and let it through.
  case "$dur" in
    ''|*[!0-9.]*) return 1 ;;
  esac
  awk -v d="$dur" -v m="$MIN_DUR" 'BEGIN { exit !(d + 0 >= m + 0) }'
}

# iTerm2 renders images inline via its own escape sequence. imgcat ships inside
# the app bundle, so it is on PATH without installing shell integration; the
# raw protocol is the fallback if it is missing.
#
# -W 100% scales to the terminal width. Without it a 2560-pixel-wide still is
# drawn at its natural size and fills the screen.
show_image() {
  local f="$1" width="${2:-100%}"
  if command -v imgcat >/dev/null 2>&1; then
    imgcat -r -W "$width" "$f"
  else
    printf '\033]1337;File=inline=1;width=%s;preserveAspectRatio=1:%s\a\n' "$width" "$(base64 < "$f")"
  fi
}

# --- list -------------------------------------------------------------------
if [ -z "$WANT_TIME" ] && [ "$PLAY_ALL" -eq 0 ]; then
  if [ "$THUMBS" -eq 1 ]; then
    [ "${TERM_PROGRAM:-}" = "iTerm.app" ] || \
      echo "note: inline images need iTerm2; TERM_PROGRAM is '${TERM_PROGRAM:-unset}'" >&2

    # Each image is passed to montage preceded by its own -label, which is how
    # montage attaches a caption per tile rather than one for the whole sheet.
    MONTAGE_ARGS=(); n=0
    for i in $(seq 0 $(( ${#CLIPS[@]} - 1 ))); do
      meets_min "${DURS[$i]}" || continue
      [ -z "${STILLS[$i]}" ] && continue
      local_still="$(fetch "${STILLS[$i]}" "$YMD")"
      MONTAGE_ARGS[${#MONTAGE_ARGS[@]}]="-label"
      MONTAGE_ARGS[${#MONTAGE_ARGS[@]}]="$(time_of "${CLIPS[$i]}")  $(echo "$(human_dur "${DURS[$i]}")" | tr -d ' ')"
      MONTAGE_ARGS[${#MONTAGE_ARGS[@]}]="$local_still"
      n=$(( n + 1 ))
    done

    if [ "$n" -eq 0 ]; then
      echo "No clips with a still matched."
      exit 0
    fi

    if command -v montage >/dev/null 2>&1; then
      # JPEG at 8 bits, not PNG: montage defaults to 16-bit colour, which
      # produced a five megabyte sheet for fifteen thumbnails. The terminal has
      # to receive every byte of that, base64 encoded.
      sheet="${CACHE}/${YMD}/.sheet-${MIN_DUR}.jpg"
      mkdir -p "$(dirname "$sheet")"
      montage -background '#1c1c1c' -fill '#dddddd' -pointsize 13 \
        -tile "${THUMB_COLS}x" -geometry "${THUMB_PX}x+5+5" \
        -depth 8 -quality 85 \
        "${MONTAGE_ARGS[@]}" "$sheet" 2>/dev/null \
        || die "montage failed building the contact sheet"
      echo "${YMD} — ${n} clips"
      show_image "$sheet" "100%"
    else
      # No ImageMagick: fall back to one per line, scaled down.
      echo "${YMD} — ${n} clips (install imagemagick for a grid)"
      for i in $(seq 0 $(( ${#CLIPS[@]} - 1 ))); do
        meets_min "${DURS[$i]}" || continue
        [ -z "${STILLS[$i]}" ] && continue
        printf '%s  %s\n' "$(time_of "${CLIPS[$i]}")" "$(human_dur "${DURS[$i]}")"
        show_image "$(fetch "${STILLS[$i]}" "$YMD")" 30
      done
    fi
    echo "Play one with: doorbell ${YMD} HH:MM"
    exit 0
  fi

  empty=0; shown=0
  for i in $(seq 0 $(( ${#CLIPS[@]} - 1 ))); do
    [ -z "${DURS[$i]}" ] && empty=$(( empty + 1 ))
  done

  if [ "$MIN_DUR" != "0" ]; then
    for i in $(seq 0 $(( ${#CLIPS[@]} - 1 ))); do
      meets_min "${DURS[$i]}" && shown=$(( shown + 1 ))
    done
    echo "${YMD} — ${shown} of ${#CLIPS[@]} events at ${MIN_DUR}s or longer"
  elif [ "$empty" -gt 0 ]; then
    echo "${YMD} — ${#CLIPS[@]} events, ${empty} unplayable (empty or truncated)"
  else
    echo "${YMD} — ${#CLIPS[@]} events"
  fi

  for i in $(seq 0 $(( ${#CLIPS[@]} - 1 ))); do
    meets_min "${DURS[$i]}" || continue
    printf '  %s  %s  %9s%s\n' \
      "$(time_of "${CLIPS[$i]}")" \
      "$(human_dur "${DURS[$i]}")" \
      "$(human_size "${SIZES[$i]}")" \
      "$(bad_label "${SIZES[$i]}" "${DURS[$i]}")"
  done
  echo
  echo "play one:  doorbell ${YMD} HH:MM"
  if [ "$MIN_DUR" != "0" ]; then
    echo "play these: doorbell ${YMD} --min ${MIN_DUR} --all"
  else
    echo "play all:  doorbell ${YMD} --all"
    echo "longer only: doorbell ${YMD} --long"
  fi
  exit 0
fi

[ -d "$VLC_APP" ] || die "VLC not found at $VLC_APP (set DOORBELL_VLC_APP)"

# --- whole day --------------------------------------------------------------
if [ "$PLAY_ALL" -eq 1 ]; then
  PLAYABLE=()
  for i in $(seq 0 $(( ${#CLIPS[@]} - 1 ))); do
    [ -z "${DURS[$i]}" ] && continue
    meets_min "${DURS[$i]}" || continue
    PLAYABLE[${#PLAYABLE[@]}]="${CLIPS[$i]}"
  done
  if [ "${#PLAYABLE[@]}" -eq 0 ]; then
    [ "$MIN_DUR" != "0" ] && die "no clips on ${YMD} are ${MIN_DUR}s or longer"
    die "no playable clips on ${YMD}"
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    echo "would fetch and queue ${#PLAYABLE[@]} of ${#CLIPS[@]} clips"
    exit 0
  fi

  echo "Fetching ${#PLAYABLE[@]} of ${#CLIPS[@]} clips for ${YMD}..."
  LOCAL_FILES=()
  for c in "${PLAYABLE[@]}"; do
    LOCAL_FILES[${#LOCAL_FILES[@]}]="$(fetch "$c" "$YMD")"
    printf '\r  %d/%d' "${#LOCAL_FILES[@]}" "${#PLAYABLE[@]}"
  done
  echo
  open -a "$VLC_APP" "${LOCAL_FILES[@]}"
  exit 0
fi

# --- nearest to a time ------------------------------------------------------
h="${WANT_TIME%%:*}"; rest="${WANT_TIME#*:}"; mi="${rest%%:*}"
# Count the colons rather than comparing the tail to the whole string. The
# previous test never fired for HH:MM, because ${WANT_TIME##*:} returns the
# MINUTES in that case rather than the original -- so "15:50" was silently
# treated as 15:50:50 and could pick the wrong clip.
case "$WANT_TIME" in
  *:*:*) s="${WANT_TIME##*:}" ;;
  *)     s=0 ;;
esac
target=$(( 10#$h * 3600 + 10#$mi * 60 + 10#$s ))

# Empty clips are skipped: a failed upload is never what someone is looking
# for, and opening a zero-byte file in VLC just produces an error.
best=""; best_delta=999999; skipped=0
for i in $(seq 0 $(( ${#CLIPS[@]} - 1 ))); do
  if [ -z "${DURS[$i]}" ]; then skipped=$(( skipped + 1 )); continue; fi
  c="${CLIPS[$i]}"
  d=$(( $(seconds_of "$c") - target )); [ "$d" -lt 0 ] && d=$(( -d ))
  if [ "$d" -lt "$best_delta" ]; then best_delta=$d; best="$c"; fi
done
[ -z "$best" ] && die "no playable clip on ${YMD} (${skipped} empty upload(s))"

printf 'Nearest to %s is %s (%dm away)\n' "$WANT_TIME" "$(time_of "$best")" "$(( best_delta / 60 ))"
if [ "$DRY_RUN" -eq 1 ]; then
  echo "would play: $best"
  exit 0
fi
open -a "$VLC_APP" "$(fetch "$best" "$YMD")"

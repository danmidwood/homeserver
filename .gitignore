/archlinux-*.iso
/user_passwords.yml*
/.#user_passwords.yml
/.superpowers/

# tests/run-promtool.sh renders prometheus.yml.j2 (it contains Jinja) into
# this file to validate the real deployed config. The harness cleans it up
# via an EXIT trap on a normal run, but an interrupted run (Ctrl-C, a
# crash, a killed terminal) can leave it behind untracked.
/tests/.prometheus.rendered.*

# Implementation plans are scaffolding: once executed, the code and the specs
# are the record. Keeping them invites the opposite of documentation — three of
# them described building Diun in detail, months after it was replaced.
/docs/superpowers/plans/

/archlinux-*.iso
/user_passwords.yml*
/.#user_passwords.yml
/.superpowers/

# tests/run-promtool.sh renders prometheus.yml.j2 (it contains Jinja) into
# this file to validate the real deployed config. The harness cleans it up
# via an EXIT trap on a normal run, but an interrupted run (Ctrl-C, a
# crash, a killed terminal) can leave it behind untracked.
/tests/.prometheus.rendered.*

# Implementation plans are scaffolding: once executed, the code and the specs
# are the record. Keeping them invites the opposite of documentation — three of
# them described building Diun in detail, months after it was replaced.
/docs/superpowers/plans/

# The bot is built from source on the host, so no binary belongs here. "go
# build" in a main package drops the compiled result into the source directory
# under the module name, and it was committed that way once: a 10MB binary
# that shipped to the server on every deploy and was modified by every local
# test run. The role installs the Go toolchain and builds on the host for
# exactly this reason.
/roles/telegrambot/files/src/telegrambot
